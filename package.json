    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.21",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
