# SnapTriage Environment Variables
# Copy this file to .env.local and fill in the values

# ─── Database ──────────────────────────────────────────────
# Leave DATABASE_URL empty to use SQLite (default)
# Set to a Postgres connection string to use Postgres
DATABASE_URL=
SQLITE_PATH=./data/snaptriage.db

# ─── Auth.js (NextAuth v5) ─────────────────────────────────
# The core secret used by NextAuth to sign session cookies and derive encryption keys.
# Generate a secure 32-character base64 string using: npx auth secret
AUTH_SECRET=

# Optional salt mixed into the PBKDF2 key derivation used to encrypt Personal Access Tokens.
# Leave this COMMENTED OUT to use the built-in default. Setting it to an empty value is a
# hard error when a key is derived; it would silently discard the per-deployment key separation.
# Generate with: openssl rand -base64 32
# WARNING: changing this invalidates every token already encrypted with the previous salt.
# Rotate the upstream provider PATs first, then change this value.
# AUTH_SALT=

AUTH_URL=http://localhost:3000

# ─── Network (optional) ───────────────────────────────────
# How many reverse proxies sit in front of the app and append the client address to
# X-Forwarded-For. Rate limiting only trusts that many entries from the end of the
# chain, so this has to match reality: 1 for Vercel, Cloudflare or a single nginx.
# Leave it at 0 when the app is exposed directly. No forwarding header can be
# believed then, so such traffic shares a single rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# ─── GitHub OAuth ──────────────────────────────────────────
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── GitLab OAuth ──────────────────────────────────────────
# Create at: https://gitlab.com/-/user_settings/applications
# Callback URL: http://localhost:3000/api/auth/callback/gitlab
AUTH_GITLAB_ID=
AUTH_GITLAB_SECRET=
AUTH_GITLAB_URL=https://gitlab.com   # Self-hosted GitLab? Change this

# ─── Sync ──────────────────────────────────────────────────
SYNC_INTERVAL_MS=300000               # 5 minutes (default)

# ─── Webhooks (optional) ──────────────────────────────────
# Shared secret for GitHub/GitLab webhook sync. Leave empty to disable webhooks.
#
# Authentication is header-borne, never a URL query string:
#   GitHub:  X-Hub-Signature-256: sha256=<HMAC-SHA256(WEBHOOK_SECRET, body)>
#   GitLab:  X-Gitlab-Token: <WEBHOOK_SECRET>
#
# Register the webhook URL without the secret:
#   https://your-app.example.com/api/webhooks/github
#   https://your-app.example.com/api/webhooks/gitlab
WEBHOOK_SECRET=
